<%- include('../layout', { body: `
	<h3 class="mb-3">New Room</h3>
	<form method="post" action="/rooms">
		<div class="mb-3">
			<label class="form-label">Number</label>
			<input class="form-control" name="number" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Type</label>
			<input class="form-control" name="type" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Rate (USD)</label>
			<input class="form-control" type="number" step="0.01" name="rate" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Description</label>
			<textarea class="form-control" name="description"></textarea>
		</div>
		<button class="btn btn-primary" type="submit">Save</button>
		<a class="btn btn-secondary" href="/rooms">Cancel</a>
	</form>
` }) %>