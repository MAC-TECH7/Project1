<%- include('../layout', { body: `
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h3>Rooms</h3>
		<a href="/rooms/new" class="btn btn-primary">Add Room</a>
	</div>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>No.</th><th>Type</th><th>Status</th><th>Rate</th><th></th>
			</tr>
		</thead>
		<tbody>
		<% (rooms || []).forEach(r => { %>
			<tr>
				<td><%= r.number %></td>
				<td><%= r.type %></td>
				<td><span class="badge text-bg-secondary"><%= r.status %></span></td>
				<td>$<%= Number(r.rate).toFixed(2) %></td>
				<td class="text-end">
					<a class="btn btn-sm btn-outline-secondary" href="/rooms/<%= r.id %>/edit">Edit</a>
					<form method="post" action="/rooms/<%= r.id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete room?')">
						<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
					</form>
				</td>
			</tr>
		<% }) %>
		</tbody>
	</table>
` }) %>