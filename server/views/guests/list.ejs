<%- include('../layout', { body: `
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h3>Guests</h3>
		<a href="/guests/new" class="btn btn-primary">Add Guest</a>
	</div>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Name</th><th>Email</th><th>Phone</th><th></th>
			</tr>
		</thead>
		<tbody>
		<% (guests || []).forEach(g => { %>
			<tr>
				<td><%= g.first_name %> <%= g.last_name %></td>
				<td><%= g.email || '' %></td>
				<td><%= g.phone || '' %></td>
				<td class="text-end">
					<a class="btn btn-sm btn-outline-secondary" href="/guests/<%= g.id %>/edit">Edit</a>
					<form method="post" action="/guests/<%= g.id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Delete guest?')">
						<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
					</form>
				</td>
			</tr>
		<% }) %>
		</tbody>
	</table>
` }) %>