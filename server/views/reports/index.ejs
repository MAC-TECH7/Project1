<%- include('../layout', { body: `
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h3>Reports</h3>
	</div>
	<form class="row g-3 mb-3" method="get">
		<div class="col-md-4">
			<label class="form-label">From</label>
			<input class="form-control" type="date" name="from" value="<%= from || '' %>" />
		</div>
		<div class="col-md-4">
			<label class="form-label">To</label>
			<input class="form-control" type="date" name="to" value="<%= to || '' %>" />
		</div>
		<div class="col-md-4 align-self-end">
			<button class="btn btn-primary" type="submit">Apply</button>
		</div>
	</form>
	<div class="row g-3">
		<div class="col-md-6">
			<div class="card">
				<div class="card-body">
					<h6 class="text-muted">Occupancy</h6>
					<p class="display-6 mb-0"><%= occupancy === null ? '-' : occupancy + '%' %></p>
				</div>
			</div>
		</div>
		<div class="col-md-6">
			<div class="card">
				<div class="card-body">
					<h6 class="text-muted">Revenue</h6>
					<p class="display-6 mb-0">$<%= revenue === null ? '-' : Number(revenue).toFixed(2) %></p>
				</div>
			</div>
		</div>
	</div>
` }) %>